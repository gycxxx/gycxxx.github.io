---
import AnimLayout from "../../layouts/AnimLayout.astro";

const STEPS = [
  {
    t: "订单服务 @GlobalTransactional 方法进入",
    d: "GlobalTransactionalInterceptorHandler 织入拦截，TransactionalTemplate 按传播性分派——本例 PROPAGATION_REQUIRED，本服务是 Launcher（发号施令的那个）。",
    src: "tm/src/main/java/org/apache/seata/tm/api/TransactionalTemplate.java:190",
    log: "TM: Launcher，进入全局事务",
    st: { tm: "进入 @GlobalTransactional", tc: "待命", rm: "待命", undo: "—", gs: "—", lock: "—", stock: "10", hl: "tm" },
  },
  {
    t: "GlobalBegin：TC 创建 GlobalSession 并分配 xid",
    d: "DefaultGlobalTransaction.begin 发 GlobalBegin RPC；TC 的 DefaultCore.begin 建 GlobalSession(Begin) 并分配 xid，SessionHolder 立刻持久化（file/db/redis/raft 四种存储之一）。",
    src: "server/src/main/java/org/apache/seata/server/coordinator/DefaultCore.java:222",
    log: "TC: GlobalSession=Begin，xid=127.0.0.1:8091:9527",
    st: { tm: "拿到 xid，存入 RootContext", tc: "begin() 建会话", rm: "待命", undo: "—", gs: "Begin", lock: "—", stock: "10", hl: "tc" },
  },
  {
    t: "RM 执行 UPDATE：五层代理就位",
    d: "DataSourceProxy.getConnection → ConnectionProxy → PreparedStatementProxy → ExecuteTemplate.execute。RootContext 里带着 xid、branchType=AT，代理链全程激活，连接的 autocommit 被强改为 false。",
    src: "rm-datasource/src/main/java/org/apache/seata/rm/datasource/ExecuteTemplate.java:60",
    log: "RM: 五层代理激活，autocommit → false",
    st: { tm: "调用库存业务", tc: "会话已建", rm: "代理链就位", undo: "—", gs: "Begin", lock: "—", stock: "10", hl: "rm" },
  },
  {
    t: "ExecuteTemplate 快速通道检查",
    d: "第一行就是快速通道：没有全局事务上下文时直接放行走原生 Statement——Seata 对无事务业务的零损耗就是这么保证的。本例有 xid，继续走 AT。",
    src: "rm-datasource/src/main/java/org/apache/seata/rm/datasource/ExecuteTemplate.java:82",
    log: "RM: 命中全局上下文 → 走 AT 代理",
    st: { tm: "调用库存业务", tc: "会话已建", rm: "快速通道判定", undo: "—", gs: "Begin", lock: "—", stock: "10", hl: "rm" },
  },
  {
    t: "一阶段 ① 前镜像 beforeImage",
    d: "UpdateExecutor.beforeImage 把 WHERE 条件拼成 SELECT ... WHERE id=100，把改之前的行快照下来：{id:100, stock:10}。",
    src: "rm-datasource/src/main/java/org/apache/seata/rm/datasource/exec/UpdateExecutor.java:67",
    log: "RM: beforeImage = {id:100, stock:10}",
    st: { tm: "调用库存业务", tc: "会话已建", rm: "SELECT 前镜像", undo: "—", gs: "Begin", lock: "—", stock: "10", hl: "rm" },
  },
  {
    t: "一阶段 ② 真正执行 UPDATE",
    d: "statementCallback.execute 调原生 JDBC 执行 UPDATE product SET stock = stock - 1 WHERE id = 100，库存 10 → 9。",
    src: "rm-datasource/src/main/java/org/apache/seata/rm/datasource/exec/AbstractDMLBaseExecutor.java:97",
    log: "RM: UPDATE 执行，stock 10 → 9",
    st: { tm: "调用库存业务", tc: "会话已建", rm: "执行业务 SQL", undo: "—", gs: "Begin", lock: "—", stock: "9（未提交）", hl: "rm" },
  },
  {
    t: "一阶段 ③ 后镜像 afterImage",
    d: "afterImage(beforeImage) 按同样的 WHERE 再 SELECT 一次，记录 {id:100, stock:9}。后镜像的唯一用途：回滚前校验有没有人脏写。",
    src: "rm-datasource/src/main/java/org/apache/seata/rm/datasource/exec/AbstractDMLBaseExecutor.java:97",
    log: "RM: afterImage = {id:100, stock:9}",
    st: { tm: "调用库存业务", tc: "会话已建", rm: "SELECT 后镜像", undo: "—", gs: "Begin", lock: "—", stock: "9（未提交）", hl: "rm" },
  },
  {
    t: "一阶段 ④ 拼 undo_log",
    d: "prepareUndoLog 把前后镜像序列化进 rollback_info（xbranch + tableName + sqlType + beforeImage/afterImage），准备 INSERT 进 undo_log 表。",
    src: "rm-datasource/src/main/java/org/apache/seata/rm/datasource/exec/AbstractDMLBaseExecutor.java:97",
    log: "RM: rollback_info 拼装完成",
    st: { tm: "调用库存业务", tc: "会话已建", rm: "prepareUndoLog", undo: "rollback_info 就绪", gs: "Begin", lock: "—", stock: "9（未提交）", hl: "rm" },
  },
  {
    t: "本地提交：doCommit 的三路分流",
    d: "ConnectionProxy.commit → doCommit：在全局事务里走 processGlobalTransactionCommit；@GlobalLock 走 checkLock 后裸提交；其余走原生 commit。",
    src: "rm-datasource/src/main/java/org/apache/seata/rm/datasource/ConnectionProxy.java:227",
    log: "RM: doCommit → 全局事务路径",
    st: { tm: "调用库存业务", tc: "会话已建", rm: "doCommit()", undo: "rollback_info 就绪", gs: "Begin", lock: "—", stock: "9（未提交）", hl: "rm" },
  },
  {
    t: "① register：先占全局锁，再提交",
    d: "register 发 BranchRegister(xid, lockKeys=product:100)。TC 的 doBranchRegister 挂上 BranchSession，并经 LockManager 抢全局锁（db 模式落在 lock_table，靠唯一索引互斥）。",
    src: "rm-datasource/src/main/java/org/apache/seata/rm/datasource/ConnectionProxy.java:267",
    log: "TC: BranchSession 挂上 + 全局锁 product:100",
    st: { tm: "调用库存业务", tc: "doBranchRegister 抢锁", rm: "register() 等 branchId", undo: "rollback_info 就绪", gs: "Begin + 1 分支", lock: "product:100 已占", stock: "9（未提交）", hl: "tc" },
  },
  {
    t: "★ 顺序精髓：register 必须在本地 commit 之前",
    d: "锁必须在数据可见之前拿到。否则别人读到未提交数据还改了它，undo_log 就失效了——这是 AT 正确性的第一道闸。",
    src: "《分布式事务深读》3.3",
    log: "★ 先拿锁 → 再 flush undo → 最后 commit",
    st: { tm: "调用库存业务", tc: "锁已持有", rm: "拿到 branchId", undo: "rollback_info 就绪", gs: "Begin + 1 分支", lock: "product:100 已占", stock: "9（未提交）", hl: "lock" },
  },
  {
    t: "② flushUndoLogs：INSERT undo_log",
    d: "undo_log 和业务 SQL 在同一个本地事务里写下去——要么都成功，要么都回滚，不会出现“业务成了但日志没了”。",
    src: "rm-datasource/src/main/java/org/apache/seata/rm/datasource/undo/AbstractUndoLogManager.java",
    log: "RM: INSERT undo_log（与业务同一本地事务）",
    st: { tm: "调用库存业务", tc: "锁已持有", rm: "flushUndoLogs", undo: "已写入本地事务", gs: "Begin + 1 分支", lock: "product:100 已占", stock: "9（未提交）", hl: "undo" },
  },
  {
    t: "③ 本地事务提交：业务与 undo 原子生效",
    d: "targetConnection.commit() 一刻，业务改动和 undo_log 一起落库。从这一刻起其他事务就能看到 stock=9 了。",
    src: "rm-datasource/src/main/java/org/apache/seata/rm/datasource/ConnectionProxy.java:227",
    log: "RM: 本地 commit 完成（业务 + undo 原子）",
    st: { tm: "调用库存业务", tc: "锁已持有", rm: "本地 commit ✓", undo: "已落库", gs: "Begin + 1 分支", lock: "product:100 已占", stock: "9 已可见", hl: "rm" },
  },
  {
    t: "④ report(true)：一阶段成功上报",
    d: "上报成功让 TC 把分支置为 Phase two Committing——这正是后面 canBeCommittedAsync 的判定依据；失败则 report(false)，TC 直接走回滚。",
    src: "rm-datasource/src/main/java/org/apache/seata/rm/datasource/ConnectionProxy.java:227",
    log: "RM → TC: report(success)，分支 → Phase two Committing",
    st: { tm: "调用库存业务", tc: "收到 report(true)", rm: "一阶段完成", undo: "已落库", gs: "Begin + 1 分支", lock: "product:100 已占", stock: "9 已可见", hl: "tc" },
  },
  {
    t: "TM 业务正常返回，发起 GlobalCommit",
    d: "DefaultGlobalTransaction.commit 发 GlobalCommit RPC，二阶段开始。",
    src: "tm/src/main/java/org/apache/seata/tm/api/DefaultGlobalTransaction.java:300",
    log: "TM: GlobalCommit →",
    st: { tm: "commit() 发 GlobalCommit", tc: "收到 GlobalCommit", rm: "一阶段完成", undo: "已落库", gs: "Begin", lock: "product:100 已占", stock: "9 已可见", hl: "tm" },
  },
  {
    t: "TC：先 close，再决定怎么提交",
    d: "DefaultCore.commit 第一件事是 globalSession.close()——关门之后迟到的 BranchRegister 全部被拒：不能“都开始提交了还有新分支进来”。",
    src: "server/src/main/java/org/apache/seata/server/coordinator/DefaultCore.java:246",
    log: "TC: close() 关门，拒绝迟到注册",
    st: { tm: "等待结果", tc: "close() → canBeCommittedAsync 判定", rm: "一阶段完成", undo: "已落库", gs: "Begin（已关门）", lock: "product:100 已占", stock: "9 已可见", hl: "tc" },
  },
  {
    t: "canBeCommittedAsync → AsyncCommitting 高性能路径",
    d: "所有分支都已 Phase two Committing 时直接 asyncCommit：不用 TC 逐个发 BranchCommit，RM 自己异步删日志——这是 Seata 提交快的核心原因。",
    src: "server/src/main/java/org/apache/seata/server/session/GlobalSession.java:165",
    log: "TC: AsyncCommitting（跳过逐分支 BranchCommit）",
    st: { tm: "等待结果", tc: "asyncCommit()", rm: "待指令", undo: "已落库", gs: "AsyncCommitting", lock: "product:100 已占", stock: "9 已可见", hl: "tc" },
  },
  {
    t: "RM 异步删 undo_log：提交不做业务补偿",
    d: "AsyncWorker 批量 deleteUndoLog——业务已经提交，AT 的提交只是清理现场，删日志不阻塞二阶段返回。",
    src: "rm-datasource/src/main/java/org/apache/seata/rm/datasource/undo/AbstractUndoLogManager.java:93",
    log: "RM: 异步 DELETE undo_log ✓",
    st: { tm: "等待结果", tc: "AsyncCommitting", rm: "异步删 undo_log", undo: "已删除", gs: "AsyncCommitting", lock: "product:100 已占", stock: "9 已可见", hl: "rm" },
  },
  {
    t: "全局事务完成：Committed 删会话",
    d: "GlobalSession 转 Committed（终态）并删除；undoLogDelete 定时任务还会向所有 RM 广播兜底删除（日志默认保留 7 天）。",
    src: "server/src/main/java/org/apache/seata/server/coordinator/DefaultCoordinator.java:549",
    log: "TC: Committed ✓ 删会话 + 广播删日志",
    st: { tm: "返回成功", tc: "会话删除", rm: "现场清理完", undo: "已删除", gs: "Committed ✓", lock: "已释放", stock: "9（最终）", hl: "ok" },
  },
  {
    t: "⚡ 异常分支：业务抛错 → GlobalRollback",
    d: "completeTransactionAfterThrowing 匹配 RollbackRule 后 tx.rollback()，TC 把会话转 Rollbacking，逐分支发 BranchRollback。",
    src: "tm/src/main/java/org/apache/seata/tm/api/TransactionalTemplate.java:318",
    log: "TC: Rollbacking → BranchRollback",
    st: { tm: "捕获异常 → rollback()", tc: "转 Rollbacking", rm: "收到回滚指令", undo: "已落库", gs: "Rollbacking", lock: "product:100 已占", stock: "9 已可见", hl: "bad" },
  },
  {
    t: "RM 回滚：校验 afterImage → 反向 SQL",
    d: "SELECT undo_log → 当前值与 afterImage 一致（不一致说明有脏写，拒绝回滚）→ 反向 UPDATE product SET stock=10 WHERE id=100 → 删 undo_log → report(false)。失败由 TC 的 handleRetryRollbacking 定时重试。",
    src: "rm-datasource/src/main/java/org/apache/seata/rm/datasource/undo/AbstractUndoLogManager.java:89",
    log: "RM: 反向 SQL 恢复 stock=10 → Rollbacked ✓",
    st: { tm: "抛出业务异常", tc: "Rollbacked 删会话", rm: "反向 SQL + 删日志", undo: "已删除", gs: "Rollbacked ✓", lock: "已释放", stock: "10 已恢复", hl: "ok" },
  },
];
---

<AnimLayout
  title="Seata AT 模式 · 两阶段提交流程"
  sub="前镜像 + 后镜像 + undo_log 三件套：register 在本地 commit 之前，undo_log 与业务在同一个本地事务里"
  back="https://gycxxx.github.io/distributed-tx/"
>
  <div class="note">
    <h3>AT 模式三句话</h3>
    <ul>
      <li>
        <b>一阶段 = 前镜像 → 执行 → 后镜像 → undo_log</b>，四件套和业务 SQL
        挤在同一个本地事务里提交，对外只表现为“一次普通的本地事务”。
      </li>
      <li>
        <b>顺序是安全性的来源</b>：先 register 占全局锁（数据可见前拿到锁），
        再 flush undo_log，最后本地 commit——三步顺序错一下，脏读就会让 undo_log 失效。
      </li>
      <li>
        <b>二阶段提交只是删日志</b>（异步、批量）；回滚才做反向 SQL，
        且先用 afterImage 校验当前值，<b>不一致就拒绝回滚</b>并进入 TC 重试。
      </li>
    </ul>
    <p style="margin:10px 0 0">
      完整源码分析（含五层代理链、TCC fence、Saga 状态机）见
      <a href="https://gycxxx.github.io/distributed-tx/">《分布式事务（Seata）源码深读》第三讲</a>。
    </p>
  </div>
</AnimLayout>

<script define:vars={{ STEPS }}>
  function col(title, sub, text, hot) {
    return (
      '<div class="s-col"><div class="box ' +
      (hot || "") +
      '"><b>' +
      title +
      "</b><code style='color:#9fd8ff'>" +
      sub +
      "</code><div style='margin-top:5px'>" +
      text +
      "</div></div></div>"
    );
  }

  Anim.create({
    steps: STEPS,
    onStep(step, i) {
      const s = step.st;
      const h = (k) => (s.hl === k ? "hot" : s.hl === "ok" ? "ok" : s.hl === "bad" ? "bad" : "");

      document.getElementById("stage").innerHTML =
        '<p class="s-title">三个角色</p>' +
        '<div class="s-row">' +
        col("TM · 订单服务", "TransactionalTemplate", s.tm, h("tm")) +
        col("TC · 事务协调者", "DefaultCore / DefaultCoordinator", s.tc, h("tc")) +
        col("RM · 订单库", "DataSourceProxy", s.rm, h("rm")) +
        "</div>" +
        '<p class="s-title" style="margin-top:18px">持久化凭据与全局状态</p>' +
        '<div class="s-row">' +
        '<div class="box ' + h("undo") + '"><b>undo_log 表</b><code>' + s.undo + "</code></div>" +
        '<div class="box ' + h("gs") + '"><b>GlobalSession</b><code>' + s.gs + "</code></div>" +
        '<div class="box ' + h("lock") + '"><b>全局锁 lock_table</b><code>' + s.lock + "</code></div>" +
        '<div class="box ' + (s.stock.indexOf("9") === 0 ? "hot" : "") + '"><b>product.stock</b><code>' + s.stock + "</code></div>";

      Anim.kv([
        ["GlobalSession 状态", s.gs, true],
        ["undo_log", s.undo, s.undo.indexOf("已") >= 0 && s.undo.indexOf("—") < 0],
        ["全局锁", s.lock, s.lock.indexOf("已占") >= 0],
        ["product.stock", s.stock, true],
      ]);
      Anim.log(STEPS, i);
    },
  });
</script>
