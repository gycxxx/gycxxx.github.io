---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
import { sortByDateDesc, groupByCategory, allTags, href, excerpt } from "../lib/docs";
import principles from "../data/principles.json";

const docs = sortByDateDesc(await getCollection("docs"));
const groups = groupByCategory(docs);
const recent = docs.slice(0, 6);
const tags = allTags(docs).slice(0, 26);
const fmt = (d: Date) => d.toISOString().slice(0, 10);

const META: Record<string, { color: string; mark: string; blurb: string }> = {
  中间件: { color: "#e07a5f", mark: "中", blurb: "消息队列与服务发现的分布式骨架" },
  Spring: { color: "#6aa84f", mark: "S", blurb: "IoC / AOP / MVC / Boot 自动装配" },
  存储与缓存: { color: "#3d7ea6", mark: "存", blurb: "Redis、MySQL、Elasticsearch 读写路径" },
  Java: { color: "#e8a33d", mark: "J", blurb: "集合、并发、锁、线程与 JVM" },
  游戏与云原生: { color: "#2a9d8f", mark: "云", blurb: "Agones 与 Open Match 的编排与匹配" },
  RAG: { color: "#8e6fd8", mark: "R", blurb: "切分、召回、融合与检索增强生成" },
  "RAG 与 Agent": { color: "#b56576", mark: "A", blurb: "Agent 编排、工具调用与知识检索" },
  学习路线: { color: "#4a7fb5", mark: "路", blurb: "按记忆曲线排的阅读顺序与全景导图" },
};
const meta = (c: string) => META[c] ?? { color: "#8a9298", mark: "·", blurb: "" };
const catColor: Record<string, string> = Object.fromEntries(
  Object.entries(META).map(([k, v]) => [k, v.color])
);

const pcats = [...new Set(principles.map((p) => p.c))].sort(
  (a, b) => principles.filter((p) => p.c === b).length - principles.filter((p) => p.c === a).length
);

const index = docs.map((d) => ({
  t: d.data.title,
  u: href(d),
  c: d.data.categories.join(" "),
  g: d.data.tags.join(" "),
  x: excerpt(d.body, 56),
}));
---

<BaseLayout title="首页" description="源码级技术笔记合集 · 305 条可检索原理结论" bleed>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="hero-main">
        <span class="hero-badge">23 份源码笔记 · 全部结论可回源码校验</span>
        <h1>读源码，<em>读到行号为止</em></h1>
        <p class="hero-sub">
          一批逐文件、逐函数的源码深读笔记。每篇遵循同一套结构：全景地图 → 速览 →
          面试速通 → 分讲精读 → 附录，所有结论都带
          <code>文件:行号</code>，并由脚本逐条回源码校验。
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#principles">浏览 {principles.length} 条原理结论 ↓</a>
          <a class="btn btn-ghost" href="/categories/">按分类读 →</a>
        </div>
      </div>

      <div class="hero-term">
        <div class="term-bar">
          <i></i><i></i><i></i>
          <span>verify_citations.py</span>
        </div>
        <pre class="term-body"><span class="c-dim">$</span> python verify_citations.py
<span class="c-ok">✓</span> open-match.md       <span class="c-num">209</span> refs OK
<span class="c-ok">✓</span> agones.md           <span class="c-num">188</span> refs OK
<span class="c-ok">✓</span> opencoze-agent.md   <span class="c-num">130</span> refs OK
<span class="c-ok">✓</span> java-collections.md <span class="c-num">111</span> refs OK
<span class="c-dim">  … 19 more files</span>
<span class="c-ok">✓</span> <span class="c-hl">3565</span> citations verified, 0 broken</pre>
      </div>
    </div>

    <div class="hero-stats">
      <div class="stat"><b>{docs.length}</b><span>篇笔记</span></div>
      <div class="stat"><b>{groups.length}</b><span>个分类</span></div>
      <div class="stat"><b>{principles.length}</b><span>条原理结论</span></div>
      <div class="stat"><b>3565</b><span>条可校验引用</span></div>
    </div>
  </section>

  <!-- ============ SEARCH ============ -->
  <section class="wrap search-sec">
    <div class="search-box">
      <svg viewBox="0 0 24 24" class="search-ico" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M20 20l-3.5-3.5"></path>
      </svg>
      <input
        id="q"
        type="search"
        placeholder="搜索笔记或原理结论…（如 扩容 / AQS / 循环依赖 / Raft）"
        autocomplete="off"
      />
      <kbd>/</kbd>
    </div>
    <div id="result" class="search-result" hidden></div>
  </section>

  <!-- ============ PRINCIPLES ============ -->
  <section class="wrap sec" id="principles">
    <div class="sec-head">
      <h2>核心原理速查</h2>
      <span class="sec-note">
        从各篇笔记「高频 Q&A」抽取，全部可回原文展开 · 共 {principles.length} 条
      </span>
    </div>
    <div class="p-filters" id="p-filters">
      <button class="p-chip on" data-cat="全部">全部 <em>{principles.length}</em></button>
      {
        pcats.map((c) => (
          <button class="p-chip" data-cat={c} style={`--accent:${meta(c).color}`}>
            {c} <em>{principles.filter((p) => p.c === c).length}</em>
          </button>
        ))
      }
    </div>
    <div class="p-list" id="p-list"></div>
    <button class="p-more" id="p-more">展开更多 ↓</button>
  </section>

  <!-- ============ CATEGORIES ============ -->
  <section class="wrap sec">
    <div class="sec-head">
      <h2>按分类浏览</h2>
      <a class="sec-more" href="/categories/">全部分类 →</a>
    </div>
    <div class="cat-grid">
      {
        groups.map(([cat, list]) => (
          <article class="cat-card" style={`--accent:${meta(cat).color}`}>
            <a class="cat-head" href={`/categories/${encodeURIComponent(cat)}/`}>
              <span class="cat-mark">{meta(cat).mark}</span>
              <span class="cat-titles">
                <b>{cat}</b>
                <i>{meta(cat).blurb}</i>
              </span>
              <span class="count">{list.length}</span>
            </a>
            <ul class="cat-items">
              {list.slice(0, 4).map((d) => (
                <li>
                  <a href={href(d)}>
                    <span>{d.data.title}</span>
                    <em>{fmt(d.data.date)}</em>
                  </a>
                </li>
              ))}
            </ul>
            {list.length > 4 && (
              <a class="cat-more" href={`/categories/${encodeURIComponent(cat)}/`}>
                还有 {list.length - 4} 篇 →
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============ ANIMATION PROMO ============ -->
  <section class="wrap sec">
    <a class="promo" href="/chm-resize-animation/">
      <span class="promo-ico">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v6H3zM3 13h18v6H3zM9 5v6M15 13v6"></path></svg>
      </span>
      <span class="promo-body">
        <b>ConcurrentHashMap 协作扩容 · 分段认领动画</b>
        <i>64 个桶、stride=16、三个线程抢段，可单步播放每一段是谁搬的</i>
      </span>
      <span class="promo-go">打开 →</span>
    </a>
  </section>

  <!-- ============ RECENT ============ -->
  <section class="wrap sec">
    <div class="sec-head">
      <h2>最近更新</h2>
      <span class="sec-note">按笔记更新时间排序</span>
    </div>
    <ul class="recent">
      {
        recent.map((d) => (
          <li>
            <a class="recent-card" href={href(d)}>
              <span class="recent-date">{fmt(d.data.date)}</span>
              <span class="recent-body">
                <b>{d.data.title}</b>
                <i>{excerpt(d.body, 96)}</i>
                <span class="recent-tags">
                  {d.data.categories.map((c) => (
                    <span class="cat-tag" style={`--accent:${meta(c).color}`}>{c}</span>
                  ))}
                </span>
              </span>
              <span class="recent-arrow">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ TAGS ============ -->
  <section class="wrap sec">
    <div class="sec-head">
      <h2>标签云</h2>
      <a class="sec-more" href="/tags/">全部标签 →</a>
    </div>
    <div class="chips">
      {
        tags.map(([t, list]) => (
          <a class="chip" href={`/tags/${encodeURIComponent(t)}/`}>
            {t}
            <em>{list.length}</em>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script define:vars={{ index, principles, catColor }}>
  const q = document.getElementById("q");
  const box = document.getElementById("result");
  const list = document.getElementById("p-list");
  const more = document.getElementById("p-more");
  const filters = document.getElementById("p-filters");
  const norm = (s) => (s || "").toLowerCase();
  const esc = (s) =>
    (s || "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);

  /* ---------- 原理速查 ---------- */
  const STEP = 12;
  let pCat = "全部";
  let pLimit = STEP;

  function pRender() {
    const all = pCat === "全部" ? principles : principles.filter((p) => p.c === pCat);
    const slice = all.slice(0, pLimit);
    list.innerHTML = slice
      .map(
        (p) =>
          `<article class="p-item" style="--accent:${catColor[p.c] || "#8a9298"}"><h3>${esc(p.q)}</h3>` +
          `<p>${esc(p.a)}</p>` +
          `<a class="p-src" href="/${p.s}/">${esc(p.t)}${p.d ? " · " + esc(p.d) : ""} →</a></article>`
      )
      .join("");
    more.hidden = pLimit >= all.length;
    more.textContent = `展开更多（还有 ${Math.max(all.length - pLimit, 0)} 条）↓`;
  }

  filters.addEventListener("click", (e) => {
    const b = e.target.closest(".p-chip");
    if (!b) return;
    pCat = b.dataset.cat;
    pLimit = STEP;
    [...filters.children].forEach((c) => c.classList.toggle("on", c === b));
    pRender();
  });

  more.addEventListener("click", () => {
    pLimit += STEP;
    pRender();
  });

  pRender();

  /* ---------- 搜索：笔记 + 原理 ---------- */
  function render(kw) {
    kw = norm(kw.trim());
    if (!kw) {
      box.hidden = true;
      box.innerHTML = "";
      return;
    }
    const dHits = index.filter(
      (d) => norm(d.t).includes(kw) || norm(d.c).includes(kw) || norm(d.g).includes(kw)
    );
    const pHits = principles.filter((p) => norm(p.q + p.a + p.t).includes(kw));

    let html = "";
    if (pHits.length) {
      html +=
        `<p class="sr-count">原理结论 ${pHits.length} 条</p>` +
        pHits
          .slice(0, 20)
          .map(
            (p) =>
              `<a class="sr-item" href="/${p.s}/"><b>${esc(p.q)}</b><span>${esc(p.c)}</span><i>${esc(p.a)}</i></a>`
          )
          .join("") +
        (pHits.length > 20 ? `<p class="sr-count">… 还有 ${pHits.length - 20} 条</p>` : "");
    }
    if (dHits.length) {
      html +=
        `<p class="sr-count">笔记 ${dHits.length} 篇</p>` +
        dHits
          .map(
            (d) =>
              `<a class="sr-item" href="${d.u}"><b>${esc(d.t)}</b><span>${esc(d.c)}</span><i>${esc(d.x)}</i></a>`
          )
          .join("");
    }
    if (!html) {
      html = `<p class="sr-empty">没有匹配 “${esc(kw)}” 的内容，换个关键词试试。</p>`;
    }
    box.hidden = false;
    box.innerHTML = html;
  }

  q.addEventListener("input", (e) => render(e.target.value));
  document.addEventListener("keydown", (e) => {
    if (e.key === "/" && document.activeElement !== q) {
      e.preventDefault();
      q.focus();
    }
    if (e.key === "Escape" && document.activeElement === q) {
      q.value = "";
      render("");
      q.blur();
    }
  });
</script>
