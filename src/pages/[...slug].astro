---
import { getCollection, render } from "astro:content";
import PostLayout from "../layouts/PostLayout.astro";
import { sortByDateDesc, href } from "../lib/docs";

export async function getStaticPaths() {
  const docs = sortByDateDesc(await getCollection("docs"));
  return docs.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: docs[i + 1] ? { href: href(docs[i + 1]), title: docs[i + 1].data.title } : undefined,
      next: docs[i - 1] ? { href: href(docs[i - 1]), title: docs[i - 1].data.title } : undefined,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<PostLayout
  title={entry.data.title}
  date={entry.data.date}
  categories={entry.data.categories}
  tags={entry.data.tags}
  headings={headings}
  prev={prev}
  next={next}
>
  <Content />
</PostLayout>
